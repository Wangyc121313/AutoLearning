{
  "name": "autolearning",
  "version": "0.1.0",
  "type": "module",
  "description": "CLI tool to generate study notes from URLs",
  "bin": {
    "autolearn": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm --out-dir dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "@mozilla/readability": "^0.5.0",
    "commander": "^13.0.0",
    "jsdom": "^25.0.0",
    "openai": "^4.73.0",
    "smol-toml": "^1.3.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
